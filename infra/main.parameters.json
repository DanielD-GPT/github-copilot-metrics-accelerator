{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "fabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID}"
    },
    "fabricSqlEndpoint": {
      "value": "${FABRIC_SQL_ENDPOINT}"
    },
    "fabricWarehouseName": {
      "value": "${FABRIC_WAREHOUSE_NAME=copilotmetrics}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "githubEnterprise": {
      "value": "${GITHUB_ENTERPRISE}"
    },
    "githubOrgs": {
      "value": "${GITHUB_ORGS}"
    },
    "githubAppId": {
      "value": "${GITHUB_APP_ID=}"
    },
    "githubAppInstallationId": {
      "value": "${GITHUB_APP_INSTALLATION_ID=}"
    },
    "ingestionSchedule": {
      "value": "${INGESTION_SCHEDULE=0 0 2 * * *}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL=}"
    }
  }
}
